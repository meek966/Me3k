# -----------------------------
# CONSENSUS AND PRICE LOGIC
# -----------------------------
def get_price(pair):
    try:
        url = f"https://api.exchangerate.host/latest?base={pair[:3]}&symbols={pair[3:]}"
        data = requests.get(url).json()
        return list(data["rates"].values())[0]
    except Exception:
        return None

def consensus(*signals):
    buy_signals = sum(1 for s in signals if "buy" in s.lower())
    sell_signals = sum(1 for s in signals if "sell" in s.lower())
    total = len(signals)
    confidence = round(abs(buy_signals - sell_signals) / total * 100, 2)
    
    if buy_signals > sell_signals:
        signal = "Strong Buy" if confidence > 70 else "Buy"
    elif sell_signals > buy_signals:
        signal = "Strong Sell" if confidence > 70 else "Sell"
    else:
        signal = "Neutral"
    return signal, confidence

def suggest_targets(price, signal, pair):
    if not price:
        return None, None
    diff = 0.002 if "JPY" not in pair else 0.2
    if "buy" in signal.lower():
        return round(price + diff, 5), round(price - diff, 5)
    elif "sell" in signal.lower():
        return round(price - diff, 5), round(price + diff, 5)
    else:
        return price, price

